// Bitwise operators and hex/binary/octal literals (D50)
print(5 & 3, 5 | 3, 5 ^ 3, ~5, ~-1)
print(1 << 10, -16 >> 2, -16 >>> 28, 1 << 31, 1 << 32)
print(0xff, 0XAB, 0b1010, 0B11, 0o17, 0O777)

// 32-bit conversion of primitives
print(2 ** 32 + 5 | 0, 3.9 | 0, -3.9 | 0, '12' & 7, true | 0, null | 0, NaN | 0, Infinity | 0)
print(~~'42.9', 2 ** 31 | 0, 0xffffffff >>> 0, 0xffffffff >> 0)

// compound assignment
let flags = 0
flags |= 0b100
flags |= 0b001
flags &= ~0b001
flags ^= 0b010
print(flags)
let n = 1
n <<= 4
n >>= 1
n >>>= 1
print(n)
const box = { bits: 0b1111 }
box.bits &= 0b0110
box['bits'] ^= 1
print(box.bits)

// precedence: shifts between + and <, bitwise between == and &&
print(1 + 2 << 3, 1 << 2 + 3, 16 >> 2 > 3, 1 | 2 == 2, (1 | 2) == 3, 6 & 3 ^ 1 | 8)
print(true && 1 | 2, 0 || 4 & 5, 3 ?? 0 ^ 1)

// a line starting with a binary operator continues the previous one
const mask = 0x0f
  | 0xf0
print(mask)
