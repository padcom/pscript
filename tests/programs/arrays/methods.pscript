const a = [1, 2, 3]
print(a.push(4, 5), a.join(), a.unshift(0), a.join())
print(a.shift(), a.pop(), a.join())
print(a.slice(1).join(), a.slice(-2).join(), a.slice(1, 2).join(), a.join())
const b = [1, 2, 3, 4, 5]
print(b.splice(1, 2).join(), b.join(), b.splice(1, 0, 'x', 'y').length, b.join())
print([1, 2].concat([3, 4], 5, [[6]]).length, [3, 1, 2].reverse().join())
print([1, 2, 1].lastIndexOf(1), [1, 2, 1].indexOf(1, 1), [1, 2].indexOf(9))
let nan = 0 / 0
print([nan].includes(nan), [nan].indexOf(nan), [-0].includes(0))
print([1, 2, 3].at(-1), [1, 2, 3].at(0), [0, 0, 0].fill(7, 1).join())
print([1, [2, 3], [4, [5]]].flat().length, [1, null, 'a'].join('|'))
