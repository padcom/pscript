// @pscript-only (override, D28): §10.17 without access modifiers (M17)
class Temperature {
  celsius = 0
  get fahrenheit() { return this.celsius * 9 / 5 + 32 }
  set fahrenheit(f) { this.celsius = (f - 32) * 5 / 9 }
  get kelvin() { return this.celsius + 273.15 }
  static get freezing() { return 32 }
}
const t = new Temperature()
t.fahrenheit = 212
print(t.fahrenheit, t.kelvin, Temperature.freezing)

class Rounded extends Temperature {
  override get fahrenheit() { return Math.round(super.fahrenheit) }   // the inherited setter still applies
}
const r = new Rounded()
r.fahrenheit = 100
print(r.fahrenheit, r.celsius > 37)
