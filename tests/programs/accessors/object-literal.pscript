// §10.9
const name = 'Ann'
const user = {
  name,
  'full name': 'Ann Smith',
  class: 'admin',
  greet() { return 'Hi, ' + this.name },
  get initials() { return 'AS' },
  set nick(v) { this.name = v },
}
print(user.greet(), '/', user['full name'], '/', user.class, user.initials)
user.nick = 'Annie'
print(user.name)
print(Object.keys(user).join(', '))
print(JSON.stringify({ a: 1, b: [true, null] }), JSON.stringify(user))
const both = { _v: 1, get v() { return this._v }, set v(x) { this._v = x } }
both.v = 5
print(both.v, Object.values(both).join())
const names = { get: 1, set() { return 2 } }
print(names.get, names.set())
