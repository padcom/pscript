// User-defined iterables with Symbol.iterator and Symbol.asyncIterator (D57)
class Range {
  from
  to
  constructor(from, to) {
    this.from = from
    this.to = to
  }
  *[Symbol.iterator]() {
    for (let i = this.from; i <= this.to; i++) yield i
  }
}
print([...new Range(1, 4)].join())
for (const n of new Range(5, 6)) print(n)
const countdown = {
  n: 3,
  [Symbol.iterator]() {
    let n = this.n
    return { next: () => (n > 0 ? { value: n--, done: false } : { value: undefined, done: true }) }
  },
}
print([...countdown].join(), Array.from(countdown).join(), Object.keys(countdown).join())
const [a, b] = new Range(10, 20)
print(a, b, typeof Symbol.iterator, String(Symbol.iterator), String(Symbol.asyncIterator))
const it = [1, 2][Symbol.iterator]()
print(it.next().value, it.next().done, new Map([[1, 2]])[Symbol.iterator]().next().value.join())
class Stream {
  async *[Symbol.asyncIterator]() { yield 'x'; yield 'y' }
}
print(new Set(new Range(1, 3)).size, JSON.stringify(countdown))

// return() is called when a loop is left early
class Tracked {
  closed = false;
  [Symbol.iterator]() {
    let i = 0
    return {
      next: () => ({ value: i++, done: false }),
      return: () => {
        this.closed = true
        return { value: undefined, done: true }
      },
    }
  }
}
const tracked = new Tracked()
for (const v of tracked) if (v == 2) break
print('closed', tracked.closed)
const [first] = new Tracked()
print('first', first)

function* wrap(iterable) { yield* iterable }
print([...wrap(new Range(1, 2))].join())
print(Symbol.iterator in countdown, 'n' in countdown)
async function main() {
  const values = []
  for await (const v of new Range(1, 3)) values.push(v)
  print('async over sync', values.join())
  for await (const s of new Stream()) print('stream', s)
}
main()
