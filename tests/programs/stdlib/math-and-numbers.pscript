print(Math.abs(-3), Math.ceil(1.2), Math.round(2.5), Math.round(-2.5), Math.trunc(-4.7), Math.sign(-3))
print(Math.min(4, 2, 8), Math.max(), Math.min(), Math.pow(2, 10), Math.sqrt(16), Math.cbrt(27), Math.hypot(3, 4))
print(Math.PI > 3.14, Math.E > 2.71, Math.log(1), Math.log2(8), Math.log10(1000), Math.exp(0))
print(Math.sin(0), Math.cos(0), Math.tan(0), Math.atan(0), Math.atan2(0, 1))
print((255).toString(16), (255).toString(2), (3.14159).toFixed(2), (1).toFixed(3), (10).toString())
print(Number.isInteger(5), Number.isInteger(5.5), Number.MAX_SAFE_INTEGER, Number.EPSILON > 0)
print(Number('12'), Number(''), Number('x'), Number(true), Number(null), Number())
print(parseInt('ff', 16), parseInt('0x1A'), parseInt('12.9'), parseFloat('3.14abc'), parseFloat('x'))
print(isNaN('abc'), isNaN('12'), isFinite('1e3'), isFinite(1 / 0), NaN == NaN, Infinity > 1e308)
print(Boolean(0), Boolean('x'), Boolean(null), Boolean({}), true.toString())
