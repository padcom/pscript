print(JSON.stringify({ u: undefined, f: () => 1, nan: NaN, inf: Infinity, arr: [undefined, () => 1] }))
print(JSON.stringify('text'), JSON.stringify(42), JSON.stringify(null), JSON.stringify(true), JSON.stringify(undefined))
print(JSON.stringify({ a: [1, { b: 2 }] }, null, 2))
print(JSON.stringify([1, 2], null, '--'))
