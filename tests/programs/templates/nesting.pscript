const items = [1, 2, 3]
print(`${items.map(i => `<${i}>`).join('')}`)
print(`outer ${`middle ${`inner ${items.length}`}`}`)
print(`${'}'} ${"${"} ${'`'}`)
print(`${(() => { const o = { a: { b: 'deep' } }; return o.a.b })()}`)
print(`${items.filter(x => { return x > 1 }).length} of ${items.length}`)
let n = 0
print(`${n++} ${n++} ${n}`)
